# Variables de Entorno para el Sistema de Pronóstico de Energía

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
POSTGRES_USER=energy_user
POSTGRES_PASSWORD=energy_pass
POSTGRES_DB=energy_forecast
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ==============================================================================
# API CONFIGURATION
# ==============================================================================
API_HOST=api
API_PORT=8000
MODEL_PATH=/app/models/best_energy_model.pkl
FEATURES_PATH=/app/models/features.pkl
METADATA_PATH=/app/models/model_metadata.pkl

# ==============================================================================
# AIRFLOW CONFIGURATION
# ==============================================================================
AIRFLOW__CORE__EXECUTOR=CeleryExecutor
AIRFLOW__CORE__SQL_ALCHEMY_CONN=postgresql+psycopg2://energy_user:energy_pass@db:5432/airflow_db
AIRFLOW__CELERY__RESULT_BACKEND=db+postgresql://energy_user:energy_pass@db:5432/airflow_db
AIRFLOW__CELERY__BROKER_URL=redis://redis:6379/0
AIRFLOW__CORE__FERNET_KEY=ZmDfcTF7_60GrrY167zsiPd67pEvs0aGOv2oasOM1Pg=
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=true
AIRFLOW__CORE__LOAD_EXAMPLES=false

# Airflow Web UI
AIRFLOW__WEBSERVER__EXPOSE_CONFIG=true
AIRFLOW__WEBSERVER__SECRET_KEY=your_secret_key_here

# Airflow Admin User
AIRFLOW_WWW_USER_USERNAME=admin
AIRFLOW_WWW_USER_PASSWORD=admin

# ==============================================================================
# WEATHER API CONFIGURATION
# ==============================================================================

# OpenWeatherMap API (Para clima en tiempo real)
# Obtener API key gratis en: https://openweathermap.org/api
# Plan gratuito: 1,000 llamadas/día
WEATHER_API_KEY=6c9bb9638b87359ade77fc7b0b2c7d3e
WEATHER_API_URL=https://api.openweathermap.org/data/2.5/weather

# NASA POWER API (Para radiación solar - NO requiere API key)
# URL: https://power.larc.nasa.gov/api/temporal/daily/point
# Totalmente gratuito, sin límites
NASA_POWER_URL=https://power.larc.nasa.gov/api/temporal/daily/point

# IP Geolocation API (Para detectar ubicación del usuario automáticamente)
# Opción 1 - ipapi.co (Recomendado - Simple)
# Plan gratuito: 1,000 requests/día sin API key
# Con API key: https://ipapi.co/pricing/
IPGEOLOCATION_PROVIDER=ipapi  # Opciones: ipapi, ipgeolocation, manual
IPAPI_KEY=  # Dejar vacío para usar plan gratuito
IPAPI_URL=https://ipapi.co/json/

# Opción 2 - ipgeolocation.io (Más completo)
# Registrarse en: https://ipgeolocation.io/
# Plan gratuito: 1,000 requests/día
IPGEOLOCATION_KEY=fdc9f46e198d4c07953a2c6f7226e811
IPGEOLOCATION_URL=https://api.ipgeolocation.io/ipgeo

# ==============================================================================
# GOOGLE AI STUDIO CONFIGURATION (Gemini API)
# ==============================================================================
# Para validación contextual avanzada de datos climáticos anómalos
# Registrarse en: https://aistudio.google.com/
# Modelos disponibles: gemini-2.0-flash, gemini-2.5-flash, gemini-2.5-pro
GOOGLE_AI_API_KEY=AIzaSyDRmG6KfPxyg8Qq8-DEVHZ31Q-PyYwhnmA
GOOGLE_AI_MODEL=gemini-2.0-flash
GOOGLE_AI_ENABLED=true

# Firebase IoT (Para sensores propios)
# URL de tu Firebase Realtime Database
FIREBASE_URL=https://si-grupo2-default-rtdb.firebaseio.com/iot_lecturas_clima.json
FIREBASE_ENABLED=true  # Cambiar a false si no usas Firebase

# Coordenadas de la ubicación por defecto (Lima, Perú)
# Se usa si falla la detección automática
LOCATION_LAT=-12.0464
LOCATION_LON=-77.0428
LOCATION_NAME=Lima
LOCATION_COUNTRY=PE

# ==============================================================================
# MODEL CONFIGURATION
# ==============================================================================
MODEL_VERSION=1.0
EXPECTED_FEATURES=17
FORECAST_HORIZON_HOURS=24
HISTORICAL_LOOKBACK_HOURS=48

# ==============================================================================
# INTELLIGENT CLIMATE AGENT CONFIGURATION
# ==============================================================================
# Configuración del agente inteligente de clima

# Prioridad de fuentes de datos (orden de preferencia)
# 1=Firebase IoT, 2=OpenWeather, 3=NASA POWER, 4=Valores por defecto
CLIMATE_DATA_PRIORITY=firebase,openweather,nasa,default

# Cache de datos climáticos (en minutos)
CLIMATE_CACHE_DURATION=10

# Habilitar detección automática de ubicación
AUTO_DETECT_LOCATION=true

# Timeout para llamadas a APIs externas (segundos)
API_TIMEOUT=5

# Reintentos en caso de fallo
API_RETRIES=2

# Valores por defecto si todas las APIs fallan
DEFAULT_TEMPERATURE=20.0
DEFAULT_HUMIDITY=65
DEFAULT_PRECIPITATION=0.0
DEFAULT_SOLAR_RADIATION=400.0

# ==============================================================================
# VALIDACIÓN INTELIGENTE DE DATOS
# ==============================================================================
# Rangos físicos válidos para Lima, Perú
TEMP_MIN_VALID=-10.0
TEMP_MAX_VALID=50.0
HUMIDITY_MIN_VALID=0
HUMIDITY_MAX_VALID=100
PRECIPITATION_MIN_VALID=0.0
PRECIPITATION_MAX_VALID=200.0
SOLAR_MIN_VALID=0.0
SOLAR_MAX_VALID=1000.0

# Configuración de detección de outliers (Z-score)
OUTLIER_ZSCORE_THRESHOLD=3.0  # 3 desviaciones estándar
OUTLIER_ZSCORE_SEVERE=5.0     # 5 desviaciones estándar = muy severo

# Habilitar validación con Google AI (solo para outliers severos)
ENABLE_AI_VALIDATION=true
AI_VALIDATION_CONFIDENCE_THRESHOLD=0.7

# ==============================================================================
# MONITORING & ALERTS
# ==============================================================================
ENABLE_EMAIL_ALERTS=false
ALERT_EMAIL=admin@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password

# Umbrales de anomalías
ENERGY_MIN_THRESHOLD_MW=3000
ENERGY_MAX_THRESHOLD_MW=8000
VARIABILITY_THRESHOLD=0.3

# ==============================================================================
# LOGGING
# ==============================================================================
LOG_LEVEL=INFO
AIRFLOW__LOGGING__LOGGING_LEVEL=INFO

# ==============================================================================
# TIMEZONE
# ==============================================================================
TZ=America/Lima
